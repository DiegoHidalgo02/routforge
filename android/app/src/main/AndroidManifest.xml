<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- requestLegacyExternalStorage: su Android 10 il backup va in Documenti solo così (T-030). allowBackup spento:
         il backup automatico di Android copierebbe su Google Drive anche la chiave Gemini (D-BACKUP-1). Il trasferimento
         diretto fra dispositivi di Android 12+ resta: porta i dati, chiave compresa, sul telefono nuovo dello stesso
         utente (D-BACKUP-3, audit C-10) -->
    <application
        android:requestLegacyExternalStorage="true"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Il widget della schermata Home (MECC §21; T-023): lo aggiorna l'app col plugin WidgetNativo -->
        <receiver
            android:name=".RoutForgeWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_routforge_info" />
        </receiver>

        <!-- Sveglie a schermo intero e notifiche dei todo armate in proprio (MECC §13.1, §13.2, §21; T-057): scatto, azioni
             senza aprire l'app e riarmo dopo il riavvio, anche prima del primo sblocco. Non esportato: il sistema lo
             raggiunge comunque (allarmi, avvio), le altre app no -->
        <receiver
            android:name=".PromemoriaReceiver"
            android:directBootAware="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- La sessione di studio con l'app chiusa: notifica fissa col cronometro (MECC §10.4, D-TIMER-2; T-021) -->
        <service
            android:name=".SessioneService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Cronometro della sessione di studio mentre l'app è chiusa" />
        </service>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Il file di backup nella cartella Documenti (T-030): il permesso serve solo fino ad Android 10 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <!-- T-021: servizio in primo piano della sessione; Non Disturbare dell'iperfocus (accesso dato dall'utente nelle
         impostazioni); vibrazione della spunta (navigator.vibrate); promemoria all'istante esatto (USE_EXACT_ALARM da
         Android 13, prima SCHEDULE_EXACT_ALARM) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- T-057: la sveglia a schermo intero sopra il blocco schermo (S8) e il riarmo dopo il riavvio (dichiarato qui, non
         solo nel manifest del plugin delle notifiche) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- T-028: la voce dell'Audio Flash-Trivia tiene acceso il processore durante la lettura (i silenzi non hanno audio);
         dichiarato qui, non solo nel manifest del plugin delle notifiche. Da Android 11 il motore di sintesi è visibile
         solo se dichiarato nelle queries -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
