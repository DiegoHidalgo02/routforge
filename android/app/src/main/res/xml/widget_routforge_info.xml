<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4×2 (MECC §21; T-023): lo aggiorna l'app quando il contenuto cambia; il ridisegno del sistema ogni 30 minuti
     nasconde ciò che è scaduto mentre l'app è chiusa (agenda di un giorno passato, «Prossima» finita) -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_routforge"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
