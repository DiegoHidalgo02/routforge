{
  "name": "routforge",
  "version": "0.1.0",
  "private": true,
  "description": "RoutForge — app di organizzazione e studio (calendario, scheduler, sessioni, corsi, pratica AI, statistiche, sync)",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run check && npm run lint && npm run format:check && npm run test",
    "design:check": "node scripts/check-design.mjs",
    "audit:claude": "node scripts/audit-claude.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "fflate": "^0.8.3"
  }
}
