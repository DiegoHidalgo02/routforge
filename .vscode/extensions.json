    "esbenp.prettier-vscode",     // Prettier al salvataggio, stesso formato del gate (D-LINT-1)
    "dbaeumer.vscode-eslint",     // ESLint nel pannello Problemi, stesse regole del gate
    "eamodio.gitlens"             // Storia dei commit dell'agente riga per riga
  ]
}
